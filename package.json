{
  "name": "anotacion-tareas",
  "version": "1.0.0",
  "private": true,
  "description": "Anotador de tareas móvil (PWA) con suite de pruebas E2E en Playwright + TypeScript",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test": "playwright test",
    "test:movil": "playwright test --project=movil",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
